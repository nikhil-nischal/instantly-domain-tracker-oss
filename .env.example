# Instantly Domain Burn Detector

# --- API ---
# This is the key for the "default" user only. Additional users (added via
# the dashboard's "Add User" flow, or multi-client setups) store their own
# key in data/users.json instead — also gitignored, never committed.
INSTANTLY_API_KEY=your_instantly_api_key_here

# --- Dashboard (web) ---
# Leave DASHBOARD_PASSWORD unset for local dev (no login wall).
# Set it in production to require a password before viewing the dashboard.
# Must be served over HTTPS in production — the session cookie is marked
# Secure once this is set, so it won't work over plain HTTP.
# DASHBOARD_PASSWORD=change-me
# Random secret used to sign session cookies — required whenever
# DASHBOARD_PASSWORD is set. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=
# PORT=8000

# --- Cron alerting (optional) ---
# If set, scripts/run_daily.sh POSTs a JSON {"text": "..."} payload here on
# failure — works as-is with Slack/Discord incoming webhooks.
# ALERT_WEBHOOK_URL=

# --- Database ---
# DATABASE_PATH=./data/instantly_tracker.db  (default, DATA_DIR/data/*.db)

# --- Burn Detection Thresholds ---
# Absolute: reply rate below this % = BURNED
BURN_REPLY_RATE_THRESHOLD=1.0
# Absolute: reply rate below this % = AT_RISK
AT_RISK_REPLY_RATE_THRESHOLD=2.0
# Absolute: bounce rate above this % = BURNED
BURN_BOUNCE_RATE_THRESHOLD=8.0
# Absolute: bounce rate above this % = AT_RISK
AT_RISK_BOUNCE_RATE_THRESHOLD=5.0

# --- Analysis ---
# Lookback window in days for domain stats
LOOKBACK_DAYS=7
# Minimum sent volume for a domain to qualify for analysis
MIN_VOLUME_THRESHOLD=50

# --- Relative Detection ---
# Flags a domain if its reply_rate < (best_rate * RELATIVE_RATE_MULTIPLIER)
# AND its reply_rate < RELATIVE_MAX_REPLY_RATE
RELATIVE_RATE_MULTIPLIER=0.3
RELATIVE_MAX_REPLY_RATE=3.0

# --- Backfill ---
# First run: pull analytics from this date
BACKFILL_START_DATE=2026-01-01
